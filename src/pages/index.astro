---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { CONTACT, SOCIAL_LINKS, EXPERIENCE, CERTIFICATIONS, SITE, AI_CREDENTIAL } from '../consts';
import heroImage from '../content/img/mrexojo-cloud.webp';

const works = (await getCollection('works')).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<BaseLayout
  title={SITE.homeTitle}
  description={SITE.description}
>
  <section class="hero section hero-grid" data-hero data-motion="static">
    <div class="hero-copy">
      <p class="eyebrow">Senior Cloud & DevSecOps Contractor</p>
      <h1 aria-label="Cloud & AI infrastructure.">Cloud & AI <span class="hero-role" aria-hidden="true">{['infrastructure', 'platforms', 'operations'].map((role, index) => <span class="hero-role-word" data-role={`${role}.`} style={`--role-delay: ${index * 4}s`}>{role}.</span>)}</span></h1>
      <p class="hero-credential"><a href={withBase('/#certifications')}>{AI_CREDENTIAL.shortName} · AI Infrastructure & Operations</a></p>
      <p class="lead">Architecture reviews, Terraform automation, cloud cost analysis and CI/CD security for engineering teams. Scoped work with documented decisions, code and handover.</p>
      <p class="hero-context">19 years in IT · Spain (CET) · Remote B2B engagements</p>
      <div class="action-row" aria-label="Main links">
        <a class="button" href={withBase('/works/')}>View services</a>
        <a class="text-link" href={withBase('/blog/')}>Read articles</a>
      </div>
    </div>
    <figure class="hero-media">
      <Image src={heroImage} alt="Reviewing infrastructure on a monitor in a server room" width={680} height={680} sizes="(min-width: 900px) 40vw, 100vw" loading="eager" />
      <figcaption>Cloud infrastructure, automation and operations.</figcaption>
      <button class="text-link hero-motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>Pause animation</button>
    </figure>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">Services</p>
      <h2 id="latest-works">Areas of work.</h2>
      <a class="text-link" href={withBase('/works/')}>All services</a>
    </div>

    {
      works.length > 0 ? (
        <div class="highlight-grid">
          {works.map((work) => (
            <article class="highlight-card">
              {work.data.thumbnail && (
                <Image
                  src={work.data.thumbnail}
                  alt=""
                  width={720}
                  height={480}
                  loading="lazy"
                />
              )}
              <div>
                <h3>
                  <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
                </h3>
                <p>{work.data.description}</p>
                {work.data.tech.length > 0 && (
                  <ul class="tag-list" aria-label={`Technologies for ${work.data.title}`}>
                    {work.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
        <p>Add services in <code>src/content/works</code> to show them here.</p>
        </div>
      )
    }
  </section>

  <section class="section split-overview" aria-labelledby="ai-focus">
    <div><p class="eyebrow">AI infrastructure</p><h2 id="ai-focus">AI infrastructure readiness.</h2></div>
    <div>
      <p class="lead">Before introducing AI workloads, assess the compute, storage and networking requirements alongside access controls, observability and cost.</p>
      <p>A readiness review identifies infrastructure constraints and produces a prioritized assessment before implementation. My NVIDIA NCA-AIIO certification supports this extension of my cloud and platform work.</p>
      <a class="text-link" href={withBase('/works/cloud-architecture-and-migration/#ai-infrastructure-readiness')}>Explore AI infrastructure readiness</a>
    </div>
  </section>

  <section class="section index-feed" id="experience" aria-label="Experience">
    <div class="section-heading">
      <p class="eyebrow">Experience</p>
      <h2>Where I've worked.</h2>
    </div>

    <div class="timeline">
      {EXPERIENCE.map((job) => (
        <article class="timeline-row">
          <div>
            <p class="meta">{job.period}</p>
            <p class="timeline-company">{job.company}</p>
          </div>
          <div>
            <h3>{job.role}</h3>
            <p>{job.description}</p>
            <ul class="tag-list" aria-label={`Stack at ${job.company}`}>
              {job.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section index-feed" aria-label="Certifications" id="certifications">
    <div class="section-heading">
      <p class="eyebrow">Certifications</p>
      <h2>Cloud & AI certifications.</h2>
    </div>
    <ul class="cert-list" aria-label="Certifications">
      {CERTIFICATIONS.map((cert) => (
        <li>
          <span>{cert.name}</span>
          <span class="meta">{cert.year}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">Blog</p>
      <h2 id="latest-notes">Articles & technical notes.</h2>
      <a class="text-link" href={withBase('/blog/')}>All posts</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              {post.data.heroImage && (
                <Image
                  src={post.data.heroImage}
                  alt=""
                  width={320}
                  height={220}
                  loading="lazy"
                />
              )}
              <div>
                <p class="meta">{formatDate(post.data.publishDate)}</p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Add posts in <code>src/content/blog</code> to show them here.</p>
        </div>
      )
    }
  </section>

  <!-- shortcut: link to the channel until videos are published; restore topic lists when videos are added. -->
  <section class="section channel-summary" aria-label="YouTube channel">
    <p>Cloud, automation and AI infrastructure on YouTube.</p>
    <a class="text-link" href="https://youtube.com/@mrexojo" target="_blank" rel="noopener noreferrer">Visit @mrexojo</a>
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-heading">
    <div class="split-overview">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-heading">Get in touch.</h2>
        <p class="lead">
          For cloud architecture, AI infrastructure readiness, Terraform, FinOps or DevSecOps — book a call or write directly.
        </p>
      </div>
      <div class="contact-channels">
        <a class="channel-row" href={`mailto:${CONTACT.email}`}>
          <span class="meta">Email</span>
          <span>{CONTACT.email}</span>
        </a>
        <a class="channel-row" href={CONTACT.calendarUrl} target="_blank" rel="noopener noreferrer"><span class="meta">Schedule</span><span>Book a call</span></a>
        {SOCIAL_LINKS.map((social) => (
          <a class="channel-row" href={social.href} target="_blank" rel="noopener noreferrer">
            <span class="meta">{social.label}</span>
            <span>@mrexojo</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const toggle = hero?.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  if (hero && toggle) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    const syncMotion = () => {
      hero.dataset.motion = reducedMotion.matches ? 'static' : paused ? 'paused' : 'running';
      toggle.hidden = reducedMotion.matches;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? 'Resume animation' : 'Pause animation';
    };
    toggle.addEventListener('click', () => { paused = !paused; syncMotion(); });
    reducedMotion.addEventListener('change', syncMotion);
    syncMotion();
  }
</script>

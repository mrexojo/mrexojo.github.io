---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { withBase } from '../../lib/url';
import authorPortrait from '../../content/img/mrexojo.webp';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const siteBase = Astro.site ?? new URL('https://mrexojo.com');
const articleSchema = {
  '@type': 'BlogPosting',
  '@id': new URL(`${Astro.url.pathname}#article`, siteBase).href,
  headline: entry.data.title, description: entry.data.description,
  datePublished: entry.data.publishDate.toISOString(),
  image: new URL(withBase(`/og/blog/${entry.id}.png`), siteBase).href,
  author: { '@id': new URL('/#person', siteBase).href },
  mainEntityOfPage: new URL(Astro.url.pathname, siteBase).href,
  inLanguage: 'en',
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  structuredData={articleSchema}
  image={withBase(`/og/blog/${entry.id}.png`)}
>
  <article data-pagefind-body>
    <header class="page-head section article-head">
      <p class="eyebrow">Article</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="entry-meta">
        <span>By <a href={withBase('/#experience')}>{SITE.title}</a></span>
        <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
        <span>{remarkPluginFrontmatter.minutesRead}</span>
        <span>{entry.data.tags.join(' / ')}</span>
      </div>
      {
        entry.data.heroImage && (
          <Image
            class="article-image"
            src={entry.data.heroImage}
            alt=""
            widths={[720, 1040, 1400]}
            sizes="(min-width: 900px) 72rem, 100vw"
          />
        )
      }
    </header>

    <div class="section article-layout">
      <aside class="article-toc" aria-label="Author and article index">
        <div class="article-author">
          <Image class="article-portrait" src={authorPortrait} alt="Miguel Ramírez Exojo" widths={[80, 160]} sizes="80px" />
          <div>
            <a href={withBase('/#experience')}>{SITE.title}</a>
            <p>Cloud infrastructure &amp; operations</p>
          </div>
        </div>
        <p class="eyebrow">Index</p>
        <nav>
          {
            headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
          }
        </nav>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
